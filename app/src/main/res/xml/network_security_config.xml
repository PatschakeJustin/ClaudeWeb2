<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 7.0 does not know the Let's Encrypt root certificates (added in 7.1.1). Many services
  (e.g. the place search for prayer times) use them, so they are added here as extra trust anchors.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
    <!-- Self-hosted AI through the SSH tunnel is plain HTTP to this device itself (the tunnel encrypts it). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
